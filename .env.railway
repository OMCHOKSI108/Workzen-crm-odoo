# Production Environment Configuration for Railway
NODE_ENV=production
PORT=4000

# Database - Will be provided by Railway MongoDB service
MONGODB_URI=${{MongoDB.MONGO_URL}}

# JWT Secret - Use Railway's secret generation
JWT_SECRET=${{JWT_SECRET}}

# CORS Configuration
CORS_ORIGIN=${{RAILWAY_PUBLIC_DOMAIN}}

# App Configuration
APP_NAME=WorkZen HRMS
APP_VERSION=1.0.0