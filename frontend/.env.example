# WorkZen HRMS Frontend Environment Configuration
# Copy this file to .env and update values for your environment

# API Configuration
VITE_API_URL=http://localhost:4000/api

# Application Settings
VITE_APP_NAME=WorkZen HRMS
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Human Resource Management System

# Development Settings
VITE_DEV_MODE=true
VITE_ENABLE_CONSOLE_LOGS=true

# Production API URL (update for deployment)
# VITE_API_URL=https://your-backend-app.onrender.com/api

# Feature Flags
VITE_ENABLE_PDF_DOWNLOAD=true
VITE_ENABLE_CURRENCY_SETTINGS=true
VITE_ENABLE_DARK_MODE=false

# Company Branding
VITE_COMPANY_NAME=WorkZen Technologies
VITE_COMPANY_LOGO=/assets/logo.png
VITE_COMPANY_WEBSITE=https://workzen.com